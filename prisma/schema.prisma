generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GUARD
  ADMIN
  FIREFIGHTER
  OPERATOR
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceType {
  ENTRY
  EXIT
}

enum AttendanceMethod {
  QR
  MANUAL
}

enum AlertType {
  FIRE
  RESCUE
  ACCIDENT
  CHEMICAL
  MEDICAL
  FLOOD
  OTHER
}

enum AlertPriority {
  HIGH
  MEDIUM
  LOW
}

enum AlertStatus {
  ACTIVE
  RESOLVED
  CANCELLED
}

enum AlertResponseType {
  GOING
  NOT_GOING
}

enum AlertAttendanceOutcome {
  NO_SHOW
}

enum IncidentStatus {
  OPEN
  CLOSED
}

enum AssetType {
  VEHICLE
  PPE
  OTHER
}

enum AssetStatus {
  OPERATIONAL
  MAINTENANCE
  OUT_OF_SERVICE
}

enum InventoryItemState {
  OK
  REVIEW
  OUT
}

enum InspectionItemResult {
  OK
  MISSING
  DAMAGED
  UNCHECKED
}

enum AttendanceAction {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceTrustLevel {
  HIGH
  MEDIUM
  REJECTED
}

enum AttendanceStatus {
  OPEN
  CLOSED
}

enum ShiftPeriod {
  DAY
  NIGHT
}

enum AvailabilityStatus {
  AVAILABLE
  ON_CALL
  UNAVAILABLE
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum DocumentKind {
  PROTOCOL
  SHIFT_REPORT
  INCIDENT_REPORT
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ComplianceSubjectType {
  USER
  ASSET
}

enum ComplianceCategory {
  TRAINING
  CERTIFICATION
  MEDICAL_EXAM
  DRIVER_LICENSE
  INSURANCE
  VTV
  SERVICE
  SCBA_SERVICE
  OTHER
}

model User {
  attendanceCorrectionsRequested AttendanceCorrection[] @relation("CorrectionRequester")
  attendanceCorrectionsDecided AttendanceCorrection[] @relation("CorrectionApprover")
  taskTransfersSent WorkTaskTransfer[] @relation("TransferFrom")
  taskTransfersReceived WorkTaskTransfer[] @relation("TransferTo")
  shiftSwapsRequested ShiftSwapRequest[] @relation("SwapFrom")
  shiftSwapsReceived ShiftSwapRequest[] @relation("SwapTo")
  shiftSwapsDecided ShiftSwapRequest[] @relation("SwapDecider")
  waterEarningsReviewed WaterTrip[] @relation("WaterEarningsReviewer")
  controlDrafts ControlDraft[]
  expenseApprovals ExpenseApproval[]
  expenseClaims ExpenseClaim[]
  financeChief Boolean @default(false)
  specialPermissions String[] @default([])
  emergencyStatusConfirmedAt DateTime?
  failedLoginCount Int @default(0)
  lockedUntil DateTime?
  guardEligible Boolean @default(false)
  // Cuenta de guardia propia (otro usuario y contraseña) vinculada a la persona titular.
  guardForUserId String? @unique
  guardFor User? @relation("GuardAccount", fields: [guardForUserId], references: [id], onDelete: SetNull)
  guardAccount User? @relation("GuardAccount")
  incidentSheets IncidentSheet[]
  driverPermissions VehicleDriverAuthorization[] @relation("DriverPerson")
  grantedDriverPermissions VehicleDriverAuthorization[] @relation("DriverGrantor")
  missionsDriven MissionMovement[] @relation("MissionDriver")
  missionsLed MissionMovement[] @relation("MissionLeader")
  missionsCreated MissionMovement[] @relation("MissionCreator")
  missionCrew MissionCrew[]
  courses CourseAttendance[] @relation("CourseOwner")
  reviewedCourses CourseAttendance[] @relation("CourseReviewer")
  receivedNotices DispatchNotice[]
  id                String    @id @default(cuid())
  username          String    @unique @db.VarChar(50)
  email             String?   @unique @db.VarChar(120)
  passwordHash      String    @db.VarChar(255)
  role              UserRole  @default(FIREFIGHTER)
  isActive          Boolean   @default(true)
  isPendingApproval Boolean   @default(false)
  mustChangePassword Boolean  @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  profile          FirefighterProfile?
  emergencyContact EmergencyContact?

  submittedApplications VolunteerApplication[] @relation("ApplicationReviewer")
  reviewedApplications  VolunteerApplication[] @relation("ApplicationReviewedBy")

  attendanceRecords AttendanceRecord[] @relation("AttendanceUser")
  attendanceCreated AttendanceRecord[] @relation("AttendanceRecordedBy")
  attendances       Attendance[]

  createdAlerts  Alert[]         @relation("AlertCreatedBy")
  resolvedAlerts Alert[]         @relation("AlertResolvedBy")
  alertResponses AlertResponse[]

  createdIncidents    Incident[]           @relation("IncidentCreatedBy")
  closedIncidents     Incident[]           @relation("IncidentClosedBy")
  incidentAssignments IncidentAssignment[]
  incidentUpdates     IncidentUpdate[]     @relation("IncidentUpdateAuthor")

  createdShifts    Shift[]           @relation("ShiftCreatedBy")
  shiftAssignments ShiftAssignment[]

  inspectionAssignments InspectionResponsible[]
  ledInspections         Inspection[] @relation("InspectionLeader")
  createdInspections     Inspection[] @relation("InspectionCreatedBy")

  chatMessages ChatMessage[] @relation("ChatMessageAuthor")
  stationEventsCreated StationEvent[] @relation("StationEventCreator")
  incidentAgenciesCreated IncidentAgency[] @relation("IncidentAgencyCreator")
  chatPollVotes ChatPollVote[]
  chatPollsClosed ChatPoll[] @relation("ChatPollCloser")
  stationEventRsvps StationEventRsvp[]
  documentReads DocumentRead[]

  auditLogsAsActor AuditLog[] @relation("AuditActor")
  complianceRecords ComplianceRecord[] @relation("ComplianceUser")
  createdComplianceRecords ComplianceRecord[] @relation("ComplianceCreatedBy")
  createdOperationalContacts OperationalContact[]
  availabilityRecords PersonnelAvailability[] @relation("AvailabilitySubject")
  editedAvailabilityRecords PersonnelAvailability[] @relation("AvailabilityEditor")
  createdMaintenanceJobs MaintenanceJob[] @relation("MaintenanceCreator")
  assignedMaintenanceJobs MaintenanceJob[] @relation("MaintenanceResponsible")
  operationalDocuments OperationalDocument[]
  authSessions AuthSession[]
  equipmentHeld PersonalEquipmentIssue[] @relation("EquipmentHolder")
  equipmentIssued PersonalEquipmentIssue[] @relation("EquipmentIssuer")
  equipmentReceived PersonalEquipmentIssue[] @relation("EquipmentReceiver")
  equipmentChecks PersonalEquipmentCheck[]
  equipmentRequests PersonalEquipmentRequest[] @relation("EquipmentRequester")
  equipmentRequestsReviewed PersonalEquipmentRequest[] @relation("EquipmentRequestReviewer")
  airHydroTests AirHydroTest[]
  airFillsOperated AirFill[] @relation("AirFillOperator")
  airFillsCreated AirFill[] @relation("AirFillCreator")
  airFillAssistance AirFillHelper[]
  airFilterChanges AirFilterChange[]
  workCreated WorkTask[] @relation("WorkCreator")
  personalDeclarations PersonalDeclaration[]
  emergencyAvailability EmergencyAvailability[]
  chatAcknowledgements ChatAcknowledgement[]
  notifications MemberNotification[]
  pushSubscriptions PushSubscription[]
  serviceParticipations ServiceParticipation[] @relation("ParticipationPerson")
  participationsRegistered ServiceParticipation[] @relation("ParticipationRegistrar")
  departureMemberships DepartureMember[]
  departuresRegistered VehicleDeparture[] @relation("DepartureRegistrar")
  controlGroups ControlGroupMember[]
  workReviewed WorkTask[] @relation("WorkReviewer")
  workAssignments WorkTaskMember[]
  workEvents WorkTaskEvent[]
  notebookEntries IncidentNotebookEntry[]
  fuelRecords FuelRecord[]
  waterTripsCreated WaterTrip[] @relation("WaterCreator")
  waterTripsLed WaterTrip[] @relation("WaterLeader")
  waterTripCrew WaterTripMember[]

  @@index([role])
  @@index([isActive])
  @@index([isPendingApproval])
}

model AuthSession {
  pushSubscriptions PushSubscription[]
  guardMode Boolean @default(false)
  id               String @id @default(uuid())
  userId           String
  refreshTokenHash String @unique @db.VarChar(64)
  userAgent        String? @db.VarChar(200)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model FirefighterProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  fullName  String    @db.VarChar(120)
  dni       String    @unique @db.VarChar(20)
  birthDate DateTime?
  rank      String    @db.VarChar(80)
  badge     String    @unique @db.VarChar(30)
  phone     String?   @db.VarChar(40)
  altPhone  String?   @db.VarChar(40)
  address   String?   @db.VarChar(180)
  bloodType String?   @db.VarChar(10)
  joinDate  DateTime?
  rankSince DateTime?
  avatarUrl String?   @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fullName])
  @@index([rank])
}

model EmergencyContact {
  id           String   @id @default(cuid())
  userId       String   @unique
  fullName     String   @db.VarChar(120)
  phone        String   @db.VarChar(40)
  relationship String?  @db.VarChar(60)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VolunteerApplication {
  id                       String            @id @default(cuid())
  desiredUsername          String            @db.VarChar(50)
  email                    String?           @db.VarChar(120)
  dni                      String            @db.VarChar(20)
  fullName                 String            @db.VarChar(120)
  birthDate                DateTime?
  phone                    String            @db.VarChar(40)
  altPhone                 String?           @db.VarChar(40)
  address                  String            @db.VarChar(180)
  bloodType                String?           @db.VarChar(10)
  emergencyContactName     String            @db.VarChar(120)
  emergencyContactPhone    String            @db.VarChar(40)
  emergencyContactRelation String?           @db.VarChar(60)
  category                 String?           @db.VarChar(50)
  message                  String?           @db.Text
  status                   ApplicationStatus @default(PENDING)
  reviewedByUserId         String?
  submittedByUserId        String?
  reviewedAt               DateTime?
  rejectReason             String?           @db.Text
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  submittedBy User? @relation("ApplicationReviewer", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedBy  User? @relation("ApplicationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([desiredUsername])
  @@index([dni])
  @@index([createdAt])
}

model AttendanceRecord {
  id               String           @id @default(cuid())
  userId           String
  type             AttendanceType
  method           AttendanceMethod @default(QR)
  recordedByUserId String?
  notes            String?          @db.VarChar(255)
  recordedAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())

  user       User  @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy User? @relation("AttendanceRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, recordedAt])
  @@index([recordedAt])
}

model Alert {
  originNotice DispatchNotice?
  id               String        @id @default(cuid())
  type             AlertType
  priority         AlertPriority
  description      String        @db.Text
  location         String        @db.VarChar(180)
  contactPhone     String?       @db.VarChar(40)
  status           AlertStatus   @default(ACTIVE)
  createdByUserId  String
  resolvedByUserId String?
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?
  updatedAt        DateTime      @updatedAt

  createdBy  User            @relation("AlertCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  resolvedBy User?           @relation("AlertResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  responses  AlertResponse[]
  incident   Incident?

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model DispatchNotice {
  revision Int @default(1)
  cancelledAt DateTime?
  cancelReason String? @db.VarChar(1000)
  id String @id @default(cuid())
  source String @db.VarChar(120)
  phone String? @db.VarChar(40)
  location String @db.VarChar(180)
  type AlertType
  priority AlertPriority
  notes String @db.VarChar(2000)
  referral String? @db.VarChar(180)
  receivedAt DateTime @default(now())
  operatorId String
  alertId String? @unique
  operator User @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  alert Alert? @relation(fields: [alertId], references: [id], onDelete: Restrict)
  @@index([receivedAt])
}

enum CourseReviewStatus {
  PENDING
  APPROVED
  REJECTED
}
model CourseAttendance {
  id String @id @default(cuid())
  userId String
  title String @db.VarChar(160)
  provider String @db.VarChar(160)
  completedOn DateTime @db.Date
  status CourseReviewStatus @default(PENDING)
  reviewerId String?
  reviewedAt DateTime?
  reviewNote String? @db.VarChar(1000)
  createdAt DateTime @default(now())
  user User @relation("CourseOwner", fields: [userId], references: [id], onDelete: Restrict)
  reviewer User? @relation("CourseReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AlertResponse {
  id          String            @id @default(cuid())
  alertId     String
  userId      String
  response    AlertResponseType
  attendanceOutcome AlertAttendanceOutcome?
  attendanceOutcomeAt DateTime?
  respondedAt DateTime          @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([alertId, userId])
  @@index([userId])
}

model Incident {
  voidedAt DateTime?
  voidReason String? @db.VarChar(2000)
  replacesIncidentId String? @unique
  replaces Incident? @relation("IncidentReplacement", fields: [replacesIncidentId], references: [id], onDelete: Restrict)
  replacement Incident? @relation("IncidentReplacement")
  sheet IncidentSheet?
  // Pedido de auxilio N° (correlativo por año, como el libro en papel). Lo asigna la base al crear.
  requestYear Int?
  requestNumber Int?
  movements MissionMovement[]
  agencies IncidentAgency[]
  id              String         @id @default(cuid())
  alertId         String?        @unique
  title           String         @db.VarChar(140)
  type            AlertType
  description     String         @db.Text
  location        String         @db.VarChar(180)
  status          IncidentStatus @default(OPEN)
  occurredAt      DateTime       @default(now())
  responseTimeMinutes Int?
  losses          String?        @db.Text
  closingReport   String?        @db.Text
  createdByUserId String
  closedByUserId  String?
  closedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  alert       Alert?               @relation(fields: [alertId], references: [id], onDelete: SetNull)
  createdBy   User                 @relation("IncidentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  closedBy    User?                @relation("IncidentClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  assignments IncidentAssignment[]
  vehicles    IncidentVehicle[]
  serviceParticipations ServiceParticipation[]
  updates     IncidentUpdate[]
  documents   OperationalDocument[]
  notebookEntries IncidentNotebookEntry[]

  @@index([status])
  @@index([occurredAt])
}

model IncidentSheet {
  incidentId String @id
  authorId String
  callerName String @default("") @db.VarChar(120)
  callerPhone String @default("") @db.VarChar(40)
  // Campos de la constancia en papel.
  addressNumber String @default("") @db.VarChar(40)
  receivedBy String @default("") @db.VarChar(120)
  firefightersOnScene String @default("") @db.VarChar(1000)
  classifications String[] @default([])
  classificationDetail String @default("") @db.VarChar(300)
  notes String @db.VarChar(4000)
  baseUserIds String[]
  materials Json
  evidenceUrls String[]
  revision Int @default(1)
  finalizedAt DateTime?
  finalContext Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  incident Incident @relation(fields:[incidentId], references:[id], onDelete:Restrict)
  author User @relation(fields:[authorId], references:[id], onDelete:Restrict)
}
model IncidentAssignment {
  id         String   @id @default(cuid())
  incidentId String
  userId     String
  assignedAt DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([incidentId, userId])
  @@index([userId])
}

model Shift {
  id              String   @id @default(cuid())
  date            DateTime
  startTime       String   @db.VarChar(5)
  endTime         String   @db.VarChar(5)
  shiftType       String   @db.VarChar(60)
  period          ShiftPeriod?
  notes           String?  @db.Text
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy   User              @relation("ShiftCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignments ShiftAssignment[]
  documents OperationalDocument[]
  serviceParticipations ServiceParticipation[]
  swapRequests ShiftSwapRequest[]

  @@index([date])
  @@unique([date, period])
}

model ShiftAssignment {
  id         String   @id @default(cuid())
  shiftId    String
  userId     String
  assignedAt DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId])
  @@index([userId])
}

model ChatMessage {
  id           String    @id @default(cuid())
  authorUserId String
  body         String    @db.Text
  audience     String    @default("ALL") @db.VarChar(16)
  isPinned     Boolean   @default(false)
  editedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  author User @relation("ChatMessageAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  acknowledgements ChatAcknowledgement[]
  poll ChatPoll?
  // Links (http/https) y fotos adjuntas al mensaje.
  links String[] @default([])
  attachments ChatAttachment[]

  @@index([createdAt])
  @@index([authorUserId])
  @@index([deletedAt])
  @@index([isPinned, createdAt])
}

model Asset {
  driverAuthorizations VehicleDriverAuthorization[]
  missions MissionMovement[]
  id            String      @id @default(cuid())
  name          String      @db.VarChar(140)
  assetType     AssetType
  status        AssetStatus @default(OPERATIONAL)
  notes         String?     @db.Text
  lastCheckDate DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  vehicle Vehicle?
  complianceRecords ComplianceRecord[]
  incidentAssignments IncidentVehicle[]
  maintenanceJobs MaintenanceJob[]
  personalEquipment PersonalEquipment?
  airCylinder AirCylinder? @relation("AirCylinderAsset")
  locatedAirCylinders AirCylinder[] @relation("AirCylinderLocation")
  airCompressor AirCompressor?
  fuelRecords FuelRecord[]
  waterTrips WaterTrip[]
  departures VehicleDeparture[]

  @@index([assetType])
  @@index([status])
}

model IncidentVehicle {
  id         String   @id @default(cuid())
  incidentId String
  assetId    String
  assignedAt DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([incidentId, assetId])
  @@index([assetId])
}

model IncidentUpdate {
  id           String    @id @default(cuid())
  incidentId   String
  authorUserId String
  body         String    @db.Text
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User     @relation("IncidentUpdateAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([incidentId, createdAt])
  @@index([authorUserId])
  @@index([deletedAt])
}

model ComplianceRecord {
  id              String                @id @default(cuid())
  subjectType     ComplianceSubjectType
  userId          String?
  assetId         String?
  category        ComplianceCategory
  title           String                @db.VarChar(140)
  issuer          String?               @db.VarChar(140)
  issuedAt        DateTime?
  expiresAt       DateTime?
  warningDays     Int                   @default(30)
  documentUrl     String?               @db.VarChar(500)
  notes           String?               @db.Text
  createdByUserId String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?

  user      User?  @relation("ComplianceUser", fields: [userId], references: [id], onDelete: Cascade)
  asset     Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy User   @relation("ComplianceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([subjectType, category])
  @@index([userId])
  @@index([assetId])
  @@index([expiresAt])
  @@index([deletedAt])
}

model Vehicle {
  controlDrafts ControlDraft[]
  kind String @default("UNCLASSIFIED") @db.VarChar(30)
  id                   String   @id @default(cuid())
  assetId              String   @unique
  unitNumber           String   @unique @db.VarChar(20)
  // Que licencia exige: LIGHT, MEDIUM, HEAVY, EXTRA_HEAVY, ARTICULATED o UNSET (habilitacion manual).
  licenseCategory      String   @default("UNSET") @db.VarChar(20)
  plate                String?  @unique @db.VarChar(20)
  year                 Int?
  mileage              Int?
  nextOilChangeMileage Int?
  // Combustible que carga la unidad (ej. "Gasoil Súper"); se muestra en el control de fluidos.
  fuelType             String?  @db.VarChar(60)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  asset          Asset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  compartments   VehicleCompartment[]
  inspections    Inspection[]
}

model VehicleCompartment {
  revision    Int @default(1)
  id          String   @id @default(cuid())
  vehicleId   String
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(255)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  items   VehicleInventoryItem[]

  @@unique([vehicleId, name])
  @@index([vehicleId, sortOrder])
}

model VehicleInventoryItem {
  revision         Int @default(1)
  labelCode        String? @unique @db.VarChar(40)
  expiresOn        DateTime? @db.Date
  id               String             @id @default(cuid())
  compartmentId    String
  name             String             @db.VarChar(140)
  expectedQuantity Int                @default(1)
  state            InventoryItemState @default(OK)
  notes            String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  compartment     VehicleCompartment @relation(fields: [compartmentId], references: [id], onDelete: Cascade)
  inspectionItems InspectionItem[]

  @@index([compartmentId])
  @@index([state])
}


model Inspection {
  draftId String? @unique
  draft ControlDraft? @relation(fields:[draftId],references:[id],onDelete:Restrict)
  confirmationsComplete Boolean @default(true)
  repairTaskId String? @unique
  repairTask WorkTask? @relation("InspectionRepair", fields: [repairTaskId], references: [id], onDelete: Restrict)
  revision         Int @default(1)
  amendment        String? @db.Text
  voidedAt         DateTime?
  voidReason       String? @db.VarChar(2000)
  id               String     @id @default(cuid())
  vehicleId        String
  incidentType     AlertType?
  inspectionDate   DateTime
  inspectionTime   String?    @db.VarChar(5)
  observations     String?    @db.Text
  // Fluidos revisados en el control: OK | LOW | ADDED (aceite, refrigerante) y FULL | THREE_QUARTERS | HALF | QUARTER | RESERVE (combustible).
  oilLevel         String?    @db.VarChar(20)
  coolantLevel     String?    @db.VarChar(20)
  fuelLevel        String?    @db.VarChar(20)
  leaderUserId     String?
  createdByUserId  String?
  resultingAssetStatus AssetStatus?
  summaryOk        Int        @default(0)
  summaryMissing   Int        @default(0)
  summaryDamaged   Int        @default(0)
  summaryUnchecked Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  vehicle      Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  leader       User?                   @relation("InspectionLeader", fields: [leaderUserId], references: [id], onDelete: SetNull)
  createdBy    User?                   @relation("InspectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
