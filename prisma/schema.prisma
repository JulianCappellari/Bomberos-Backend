  registeredBy User @relation("ParticipationRegistrar", fields: [registeredByUserId], references: [id], onDelete: Restrict)
  shift Shift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  @@index([userId, startedAt])
}

model VehicleDeparture {
  mission MissionMovement?
  id String @id @default(cuid())
  operationKey String @unique @db.Uuid
  requestHash String @db.VarChar(64)
  assetId String
  departedAt DateTime
  returnedAt DateTime
  purpose String @db.VarChar(200)
  notes String @db.VarChar(2000)
  createdByUserId String
  createdAt DateTime @default(now())
  revision Int @default(1)
  voidedAt DateTime?
  voidReason String? @db.VarChar(2000)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  createdBy User @relation("DepartureRegistrar", fields: [createdByUserId], references: [id], onDelete: Restrict)
  crew DepartureMember[]
  @@index([assetId, departedAt])
}
model VehicleDriverAuthorization {
  licenseId String?
  licenseRevision Int?
  license PersonalDeclaration? @relation(fields:[licenseId],references:[id],onDelete:Restrict)
  user User @relation("DriverPerson", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("DriverGrantor", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  assetId String
  userId String
  requiredClass String @db.VarChar(12)
  validUntil DateTime @db.Date
  // Pedido de habilitacion: PENDING (se genera al cargar una licencia que cubre el movil), APPROVED, REJECTED o REVOKED.
  // Para manejar hace falta la licencia vigente Y la autorizacion de jefatura (oficial o administrador).
  status String @default("APPROVED") @db.VarChar(12)
  requestedAt DateTime @default(now())
  decidedAt DateTime?
  decisionNote String? @db.VarChar(1000)
  grantedByUserId String?
  reason String @default("") @db.VarChar(1000)
  revision Int @default(1)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  @@id([assetId,userId])
}
model MissionMovement {
  returnWithoutArrivalReason String? @db.VarChar(1000)
  dispatchExceptionReason String? @db.VarChar(1000)
  driver User @relation("MissionDriver", fields: [driverUserId], references: [id], onDelete: Restrict)
  leader User @relation("MissionLeader", fields: [leaderUserId], references: [id], onDelete: Restrict)
  createdBy User @relation("MissionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  departure VehicleDeparture? @relation(fields: [departureId], references: [id], onDelete: Restrict)
  id String @id @default(cuid())
  incidentId String
  assetId String
  driverUserId String
  leaderUserId String
  createdByUserId String
  departedAt DateTime @default(now())
  arrivedAt DateTime?
  returnedAt DateTime?
  departureId String? @unique
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  crew MissionCrew[]
  @@index([incidentId,departedAt])
  @@index([assetId,returnedAt])
}
model MissionCrew {
  movementId String
  userId String
  movement MissionMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([movementId,userId])
  @@index([userId])
}
model DepartureMember {
  departureId String
  userId String
  isLeader Boolean @default(false)
  departure VehicleDeparture @relation(fields: [departureId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([departureId, userId])
  @@index([userId])
}

model Station {
  id           String   @id @default(cuid())
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int      @default(60)
  // false: base habilitada para fichar con QR sin pedir ubicacion (uso provisorio).
  requiresLocation Boolean @default(true)
  allowedIp    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  qrChallenges   QrChallenge[]
  attendances    Attendance[]
  trustedDevices TrustedDevice[]
}

model QrChallenge {
  id              String    @id @default(cuid())
  stationId       String
  tokenHash       String    @unique
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  createdByUserId String?
  consumedCount   Int       @default(0)
  revokedAt       DateTime?

  station Station @relation(fields: [stationId], references: [id])

  @@index([stationId, expiresAt])
}

model TrustedDevice {
  id          String   @id @default(cuid())
  stationId   String
  name        String
  fingerprint String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  station Station @relation(fields: [stationId], references: [id])

  @@index([stationId, isActive])
}

model Attendance {
  discardedAt DateTime?
  discardReason String? @db.VarChar(200)
  corrections AttendanceCorrection[]
  promptShownAt DateTime?
  promptDueAt DateTime?
  presenceResumeAt DateTime?
  id            String           @id @default(cuid())
  userId        String
  stationId     String
  status        AttendanceStatus @default(OPEN)

  checkInAt  DateTime?
  checkOutAt DateTime?

  workedMinutes Int?
  lastPresenceConfirmedAt DateTime?
  
  checkInTrust  AttendanceTrustLevel?
  checkOutTrust AttendanceTrustLevel?
  // Como se cerro: QR, REMOTE (a distancia, con tope verificado), REMOTE_LATE (a distancia, mas de 2 h despues de la ultima presencia) o REMOTE_GPS (sin QR, con GPS en el cuartel).
  checkOutMethod String? @db.VarChar(20)

  checkInLatitude   Float?
  checkInLongitude  Float?
  checkInAccuracy   Float?
  checkOutLatitude  Float?
  checkOutLongitude Float?
  checkOutAccuracy  Float?

  checkInIp  String?
  checkOutIp String?

  checkInDevice  String?
  checkOutDevice String?

  checkInQrId  String?
  checkOutQrId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([stationId, createdAt])
}

model AttendanceCorrection {
  id String @id @default(cuid())
  attendanceId String
  action String @db.VarChar(16)
  effectiveAt DateTime
  reason String @db.VarChar(2000)
  status String @default("PENDING") @db.VarChar(16)
  requestedByUserId String
  decidedByUserId String?
  decisionNote String? @db.VarChar(1000)
  decidedAt DateTime?
  createdAt DateTime @default(now())
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  requestedBy User @relation("CorrectionRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decidedBy User? @relation("CorrectionApprover", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  @@index([status, createdAt])
  @@index([attendanceId])
}

model WorkTaskTransfer {
  id String @id @default(cuid())
  taskId String
  fromUserId String
  toUserId String
  notes String @db.VarChar(1000)
  status String @default("PENDING") @db.VarChar(16)
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  task WorkTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  from User @relation("TransferFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  to User @relation("TransferTo", fields: [toUserId], references: [id], onDelete: Restrict)
  @@index([toUserId, status])
  @@index([taskId, status])
}

model ShiftSwapRequest {
  id String @id @default(cuid())
  shiftId String
  fromUserId String
  toUserId String?
  isOpenOffer Boolean @default(false)
  reason String @db.VarChar(1000)
  status String @default("PENDING") @db.VarChar(16)
  acceptedAt DateTime?
  decidedByUserId String?
  decisionNote String? @db.VarChar(1000)
  decidedAt DateTime?
  createdAt DateTime @default(now())
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  from User @relation("SwapFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  to User? @relation("SwapTo", fields: [toUserId], references: [id], onDelete: Restrict)
  decidedBy User? @relation("SwapDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  @@index([shiftId, status])
  @@index([toUserId, status])
  @@index([isOpenOffer, status])
}

// 27: agenda del cuartel con confirmacion de asistencia.
model StationEvent {
  id String @id @default(cuid())
  title String @db.VarChar(160)
  description String @default("") @db.VarChar(4000)
  kind String @db.VarChar(16)
  location String @default("") @db.VarChar(200)
  startsAt DateTime
  endsAt DateTime
  createdByUserId String
  cancelledAt DateTime?
  cancelReason String? @db.VarChar(1000)
  reminderSentAt DateTime?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User @relation("StationEventCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  rsvps StationEventRsvp[]
  @@index([startsAt])
}

model StationEventRsvp {
  eventId String
  userId String
  response String @db.VarChar(12)
  respondedAt DateTime @default(now())
  event StationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([eventId, userId])
  @@index([userId])
}

// 30: registro de lectura de cada version publicada de un documento o protocolo.
model DocumentRead {
  documentId String
  userId String
  revision Int
  readAt DateTime @default(now())
  document OperationalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([documentId, userId, revision])
  @@index([userId])
}

// 14: requisitos para estar en condiciones de ascender desde cada cargo.
model PromotionRule {
  rank String @id @db.VarChar(80)
  nextRank String @db.VarChar(80)
  minYearsInRank Int @default(0)
  minYearsService Int @default(0)
  minApprovedCourses Int @default(0)
  updatedByUserId String?
  updatedAt DateTime @updatedAt
}

// 62: instituciones que participaron en una intervencion. No se borran: se anulan con motivo.
model IncidentAgency {
  id String @id @default(cuid())
  incidentId String
  agencyType String @db.VarChar(20)
  name String @db.VarChar(160)
  contactId String?
  unit String @default("") @db.VarChar(80)
  inCharge String @default("") @db.VarChar(120)
  phone String? @db.VarChar(40)
  arrivedAt DateTime?
  leftAt DateTime?
  notes String @default("") @db.VarChar(2000)
  createdByUserId String
  revision Int @default(1)
  voidedAt DateTime?
  voidReason String? @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  contact OperationalContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy User @relation("IncidentAgencyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  @@index([incidentId])
  @@index([agencyType])
}

// Encuestas en Comunicaciones (como en WhatsApp): una o varias opciones, voto modificable mientras esta abierta.
model ChatPoll {
  id String @id @default(cuid())
  messageId String @unique
  allowMultiple Boolean @default(false)
  closedAt DateTime?
  closedByUserId String?
  createdAt DateTime @default(now())
  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  closedBy User? @relation("ChatPollCloser", fields: [closedByUserId], references: [id], onDelete: SetNull)
  options ChatPollOption[]
  votes ChatPollVote[]
}

model ChatPollOption {
  id String @id @default(cuid())
  pollId String
  text String @db.VarChar(120)
  position Int
  poll ChatPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes ChatPollVote[]
  @@unique([pollId, position])
}

model ChatPollVote {
  pollId String
  optionId String
  userId String
  votedAt DateTime @default(now())
  poll ChatPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option ChatPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([optionId, userId])
  @@index([pollId, userId])
}

model ChatAttachment {
  id        String   @id @default(cuid())
  messageId String
  bytes     Bytes
  sha256    String   @db.VarChar(64)
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// Deposito del cuartel: vestimenta, EPP y materiales con stock por cantidad.
model SupplyItem {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(140)
  category    String    @db.VarChar(30)
  size        String?   @db.VarChar(30)
  unit        String    @default("unidad") @db.VarChar(20)
  quantity    Int       @default(0)
  minQuantity Int       @default(0)
  location    String?   @db.VarChar(120)
  notes       String?   @db.VarChar(1000)
  revision    Int       @default(1)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  movements SupplyMovement[]
  requests  MaterialRequest[]

  @@index([archivedAt, category])
}

// Alta (IN), baja (OUT), entrega a una persona o movil (ASSIGN), faltante o perdida (LOSS) y recuento (ADJUST).
model SupplyMovement {
  id              String   @id @default(cuid())
  itemId          String
  type            String   @db.VarChar(10)
  quantity        Int
  balanceAfter    Int
  reason          String   @db.VarChar(500)
  assignedUserId  String?
  vehicleId       String?
  requestId       String?
  createdByUserId String
  createdAt       DateTime @default(now())

  item SupplyItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([itemId, createdAt])
  @@index([createdAt])
}

// Pedido de materiales para un movil o el cuartel (por ej. "foco para el camion 8").
model MaterialRequest {
  id                String    @id @default(cuid())
  title             String    @db.VarChar(160)
  details           String?   @db.VarChar(2000)
  destination       String    @db.VarChar(10)
  vehicleId         String?
  quantity          Int       @default(1)
  priority          String    @default("NORMAL") @db.VarChar(10)
  status            String    @default("PENDING") @db.VarChar(12)
  requestedByUserId String
  handledByUserId   String?
  handledAt         DateTime?
  handlerNotes      String?   @db.VarChar(2000)
  supplyItemId      String?
  revision          Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  supplyItem SupplyItem? @relation(fields: [supplyItemId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([requestedByUserId, createdAt])
}
